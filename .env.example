# ╔══════════════════════════════════════════════════════════════════╗
# ║          TZAR ENTERPRISE CRM — ENVIRONMENT VARIABLES            ║
# ║  Copy this file to .env.local and fill in real values          ║
# ║  NEVER commit .env.local to git                                ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── App Configuration ──────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── MongoDB Atlas ───────────────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tzar_crm_db?retryWrites=true&w=majority

# ─── NextAuth.js v5 ──────────────────────────────────────────────────
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=replace_with_openssl_rand_output_32_bytes
NEXTAUTH_URL=http://localhost:3000

# ─── External Lead Ingestion Gateway ─────────────────────────────────
# This key must match what the Tzar website sends in x-tzar-api-key header
TZAR_INGEST_API_KEY=tzar_live_ingest_key_XXXXXXXXXXXXXX

# ─── WhatsApp Business Cloud API ─────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_PERMANENT_ACCESS_TOKEN=EAAG...
WHATSAPP_VERIFY_TOKEN=tzar_whatsapp_webhook_verify_token_2026

# ─── Google Workspace / Gmail OAuth2 ─────────────────────────────────
GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-secret_key_here

# ─── Meta Graph API & Lead Ads ───────────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_SYSTEM_USER_TOKEN=EAAB...
META_PAGE_ACCESS_TOKEN=your_page_access_token

# ─── AWS S3 (Mumbai / ap-south-1) ────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=tzar-crm-file-assets
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your_secret_key

# ─── Upstash QStash (Background Jobs) ────────────────────────────────
# Sign up at: https://console.upstash.com/qstash
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...

# ─── Default Dev Credentials (Seeded Demo Accounts) ────────────────
DEMO_ADMIN_EMAIL=admin@tzar.agency
DEMO_ADMIN_PASSWORD=admin123
DEMO_BDE_EMAIL=bde@tzar.agency
DEMO_BDE_PASSWORD=bde123

